# Salin jadi .env.local untuk `vercel dev`,
# dan isi nilainya di Vercel → Settings → Environment Variables untuk produksi.

MQTT_HOST=broker.contoh.id
MQTT_PROTOCOL=wss
MQTT_PORT=8084
MQTT_PATH=/mqtt
MQTT_USER=seok
MQTT_PASS=gantiiniya

# Dari Supabase Dashboard -> Project Settings -> API.
# PENTING: service_role key ini BUKA SEMUA proteksi database (bypass RLS).
# HANYA dipakai di serverless function (server), TIDAK PERNAH dikirim ke
# browser. Jangan pernah taruh ini di kode yang jalan di sisi client.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# String acak sepanjang mungkin, dipakai menandatangani session cookie login.
# Generate sendiri, jangan dipakai bersama project lain. Contoh cara bikin:
# openssl rand -base64 32
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
